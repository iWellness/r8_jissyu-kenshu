---
import Search from '@/components/Search.astro';
import '@/styles/global.css';

export interface Props {
  /** Browser and social title. */
  title: string;
  /** Page summary for search engines. */
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = title === 'BI実践研修' ? title : `${title} | BI実践研修`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script is:inline>document.documentElement.dataset.js = 'true';</script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class="site-header">
      <a class="site-brand" href={import.meta.env.BASE_URL}>BI実践研修</a>
      <Search />
    </header>
    <slot />
    <script>
      import '@/scripts/interactions';
    </script>
  </body>
</html>
