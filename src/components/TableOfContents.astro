---
import type { MarkdownHeading } from 'astro';

export interface Props {
  /** Rendered lesson headings. Only levels 2 and 3 are shown. */
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const visible = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{visible.length > 0 && (
  <nav class="toc" aria-label="このページの目次">
    <p>このページ</p>
    <ol>{visible.map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
  </nav>
)}
