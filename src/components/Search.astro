---
import { Button } from '@/components/ui/button';
---

<div class="search js-only" data-search>
  <Button type="button" variant="outline" size="sm" className="search__open" data-search-open aria-haspopup="dialog">教材内を検索</Button>
  <dialog class="search__dialog" data-search-dialog aria-labelledby="search-title">
    <form method="dialog" class="search__header">
      <strong id="search-title">教材内を検索</strong>
      <Button type="submit" variant="ghost" size="sm" aria-label="検索を閉じる">閉じる</Button>
    </form>
    <label for="site-search">キーワード</label>
    <input id="site-search" type="search" inputmode="search" autocomplete="off" data-search-input />
    <p class="search__state" data-search-state aria-live="polite">キーワードを入力してください。</p>
    <ol class="search__results" data-search-results></ol>
  </dialog>
</div>
